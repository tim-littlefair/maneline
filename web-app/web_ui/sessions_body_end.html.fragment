sessions = #SESSIONS_JSON#

function populate_table() {
    tbody_inner_html = ""
    for(let i=0; i<sessions.length; ++i) {
        session = sessions[i]
        tbody_inner_html += "<tr>\n"
        tbody_inner_html +="<td>" + session.name + "<td>\n"
        tbody_inner_html +="<td>" + session.start_date + "<td>\n"
        tbody_inner_html +="<td>" + session.start_time + "<td>\n"
        tbody_inner_html +="<td>" + session.duration_mins + "<td>\n"
        tbody_inner_html +="<td>" + "<a>presets</a>" + "<td>\n"
        tbody_inner_html +="<td>" + "<a>everything</a>" + "<td>\n"
        tbody_inner_html += "</tr>\n"
    }
    document.querySelector("tbody").innerHTML = tbody_inner_html
}

window.onload = populate_table

</script>

</html>


