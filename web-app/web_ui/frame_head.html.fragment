<!DOCTYPE html>
<html class="writer-html5" lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="description" content="">
  <meta name="author" content="Tim Littlefair">

  <!--
    - The meta tag on the next line directs
    - the browser to refresh the page once
    - every 6 hours (i.e. every 14400 seconds).
    - Hopefully, under normal usage this
    - behaviour is near enough to 'never refresh'
    - to avoid causing inconvenience (either to
    - the CPU or the user viewing the UI).
    - The 14400 parameter can be substituted
    - when rendering pages which do require require
    - auto-refresh (e.g. the area which displays
    - the current preset).
    -->
  <meta http_equiv='refresh' content='14400'/>

  <!--
  Prevent Chrome etc from wasting memory/CPU doing prefetches of session zip files
  as soon as it sees links to them
  -->
  <meta http-equiv="x-dns-prefetch-control" content="off">

  <title>Maneline Web UI</title>

  <link rel="stylesheet" href="/web_ui/_static/css/theme.css" type="text/css" />
  <link rel="stylesheet" href="/web_ui/_static/pygments.css" type="text/css" />
  <link rel="stylesheet" href="/web_ui/_static/style-font.css" type="text/css" />

  <style>
    button {
      width: 105px;
      height: auto;
    }
    .session_table {
      border: 2px solid rgb(0 0 0);
      padding: 5px;
    }
  </style>
</head>

