# Maintainer: joba1 <joba-1@users.noreply.github.com>
# maneline as a distribution package; for now its Mustang Micro Plus programs.
# See README.md next to this file.
pkgname=maneline
pkgver=0.3.6
pkgrel=1
pkgdesc="Tools for Fender Mustang amplifiers (for now the Mustang Micro Plus)"
arch=('any')
url="https://github.com/tim-littlefair/maneline"
license=('GPL-2.0-only AND MIT AND OFL-1.1 AND Apache-2.0')
depends=('python>=3.11' 'python-dbus-fast' 'bluez>=5.86')
checkdepends=('python-numpy')
optdepends=('python-numpy: mmp-level, analysis'
            'pipewire-audio: mmp-level, recording (pw-record)'
            'libpulse: mmp-level, finding the amp (pactl)')
source=("$pkgname-$pkgver.tar.xz")
sha256sums=('SKIP')

check() {
    cd "$pkgname-$pkgver"
    python -m unittest discover -s scripts/tests
}

package() {
    cd "$pkgname-$pkgver"
    deployment/packages/maneline/install.sh "$pkgdir"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
